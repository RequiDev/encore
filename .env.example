# Encore configuration
#
# Copy to .env and fill in the marked values:
#     cp .env.example .env
#
# Every variable Encore reads is listed here. Defaults shown are what the
# application uses when the variable is unset; you only need to change the ones
# marked REQUIRED. Full reference: docs/configuration.md
#
# .env is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Where browsers reach the API and the web UI. These must be the URLs you type
# into your browser, not container names or Docker-internal addresses: they end
# up in OAuth redirects and in cookie attributes.
#
# Use 127.0.0.1 rather than localhost. Spotify rejects `localhost` as a redirect
# URI and requires either HTTPS or an explicit loopback literal. Keep the host
# form identical in both values: `localhost` and `127.0.0.1` are different
# origins for cookies, and mixing them signs you straight back out.
#
# Deploying anywhere other than the machine you browse from needs HTTPS, because
# only loopback addresses are exempt. See docs/deployment.md.
ENCORE_PUBLIC_URL=http://127.0.0.1:8080
ENCORE_WEB_URL=http://127.0.0.1:3000

# Spotify application credentials, from https://developer.spotify.com/dashboard
# The redirect URI registered there must be exactly:
#     ${ENCORE_PUBLIC_URL}/api/auth/spotify/callback
ENCORE_SPOTIFY_CLIENT_ID=replace-me
ENCORE_SPOTIFY_CLIENT_SECRET=replace-me

# 32-byte key that encrypts Spotify tokens at rest. Generate one with:
#     openssl rand -base64 32
# Changing it makes every stored token undecryptable and forces all users to
# reconnect their Spotify account. Back it up with your database.
ENCORE_ENCRYPTION_KEY=replace-me

# PostgreSQL password used by the bundled compose stack.
POSTGRES_PASSWORD=change-me-too

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set automatically inside docker compose. Override for a local (non-Docker) run:
#ENCORE_DATABASE_URL=postgres://encore:encore@localhost:5432/encore?sslmode=disable
#ENCORE_DATABASE_MAX_CONNS=10
#ENCORE_DATABASE_MIN_CONNS=0
#ENCORE_DATABASE_CONNECT_TIMEOUT=10s
#ENCORE_DATABASE_STATEMENT_TIMEOUT=60s
# Run pending migrations during API startup. Off by default: the compose stack
# runs them as a separate, observable step instead.
#ENCORE_DATABASE_MIGRATE_ON_START=false

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
#ENCORE_HTTP_ADDR=:8080
#ENCORE_HTTP_READ_TIMEOUT=30s
#ENCORE_HTTP_WRITE_TIMEOUT=60s
#ENCORE_HTTP_IDLE_TIMEOUT=120s
#ENCORE_HTTP_SHUTDOWN_TIMEOUT=20s
#ENCORE_HTTP_MAX_REQUEST_BYTES=1mb
# Comma-separated exact origins. Leave unset when the bundled nginx serves the
# UI from the same origin as the API, which needs no CORS at all.
#ENCORE_CORS_ORIGINS=https://encore.example.com
# Only enable behind a reverse proxy you control; it makes Encore believe
# X-Forwarded-For, which an attacker can otherwise forge.
#ENCORE_TRUST_PROXY_HEADERS=false
# Sites permitted to frame Encore. Unset means none, which is the safe default.
#ENCORE_FRAME_ANCESTORS=

# ---------------------------------------------------------------------------
# Sessions and cookies
# ---------------------------------------------------------------------------
#ENCORE_SESSION_TTL=720h
#ENCORE_COOKIE_NAME=encore_session
#ENCORE_COOKIE_DOMAIN=
#ENCORE_COOKIE_PATH=/
# Must be true in production. Automatically defaults to false when ENCORE_ENV=development
# so that plain-http localhost still works.
#ENCORE_COOKIE_SECURE=true
#ENCORE_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Instance behaviour
# ---------------------------------------------------------------------------
#ENCORE_ENV=production
#ENCORE_DEFAULT_TIMEZONE=UTC
# Seeds the registrations_enabled setting on a brand-new database only.
# Afterwards an administrator controls it from the Settings page.
#ENCORE_REGISTRATIONS_DEFAULT=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
#ENCORE_LOG_LEVEL=info
#ENCORE_LOG_FORMAT=json
#ENCORE_LOG_SOURCE=false

# ---------------------------------------------------------------------------
# Spotify API behaviour
# ---------------------------------------------------------------------------
# Defaults to ${ENCORE_PUBLIC_URL}/api/auth/spotify/callback
#ENCORE_SPOTIFY_REDIRECT_URL=
# Sustained requests per second Encore allows itself.
#
# Keep this low. A Spotify app starts in development mode, whose daily quota is
# small, and exhausting it returns a 429 with a Retry-After of nearly a day —
# during which no track, artist or album metadata can be fetched at all. Nothing
# needs the speed: a sixteen-thousand-track backlog is about three hundred
# requests, roughly three minutes at this rate. Raise it only if your app has
# been granted extended quota mode.
#ENCORE_SPOTIFY_RATE_LIMIT=2
#ENCORE_SPOTIFY_RATE_BURST=4
#ENCORE_SPOTIFY_TIMEOUT=20s
#ENCORE_SPOTIFY_MAX_RETRIES=5

# ---------------------------------------------------------------------------
# Recently-played synchronisation
# ---------------------------------------------------------------------------
#ENCORE_SYNC_ENABLED=true
#ENCORE_SYNC_INTERVAL=60s
#ENCORE_SYNC_CONCURRENCY=4
#ENCORE_SYNC_INITIAL_LOOKBACK=336h

# ---------------------------------------------------------------------------
# Library and follows synchronisation
# ---------------------------------------------------------------------------
# Enumerates saved tracks, saved albums, followed artists and (scope
# permitting) the listener's own playlists and Spotify's own top artists/
# tracks once a day, and reconciles or captures them locally. On by default,
# unlike the pollers below: a run costs roughly
#   ceil(saved_tracks/50) + ceil(saved_albums/50) + ceil(followed/50)
#     + 6 + ceil(playlists/50)
# requests per account per day, a few hundred at most for a large library,
# against a quota a single import can exhaust. Set to false to disable.
#ENCORE_LIBRARY_SYNC_ENABLED=true
#ENCORE_LIBRARY_SYNC_INTERVAL=24h
#ENCORE_LIBRARY_SYNC_CONCURRENCY=2
#ENCORE_LIBRARY_SYNC_MAX_PAGES=200

# ---------------------------------------------------------------------------
# Now playing
# ---------------------------------------------------------------------------
# Shows a card on the dashboard with what you are listening to right now, read
# from Spotify on a timer. Unset — the default — means Encore never asks, and
# the card does not appear.
#
# It is opt-in because the cost is recurring and per account:
#   1 account  at 30s  ~=  2,880 requests/day
#   5 accounts at 30s  ~= 14,400 requests/day
#   5 accounts at 60s  ~=  7,200 requests/day
# A development-mode Spotify application can exhaust its daily quota during a
# single large import, and a poller that quietly doubled the baseline would make
# that worse for everybody on the instance.
#
# The poller has a rate budget of its own, so a 429 on it backs off the poller
# and nothing else: enrichment, "sync now" and the recently-played poller are
# unaffected. It never writes to your listening history — that still comes only
# from the recently-played feed.
#
# Minimum 10s. Accounts that have not granted user-read-playback-state are
# skipped without a request.
#ENCORE_NOWPLAYING_INTERVAL=30s

# ---------------------------------------------------------------------------
# Album track listings
# ---------------------------------------------------------------------------
# The album page names the tracks you have never played, which needs Spotify's
# own track list for that album. It is read the first time somebody opens that
# album's page and then cached, so one instance spends roughly
#   ceil(album_tracks/50)
# requests per album *viewed*, per TTL — one request for almost every album,
# and nothing at all for albums nobody opens. There is deliberately no
# background sweep: most albums in a large history are never looked at, and
# enumerating them all would spend the quota on questions nobody asked.
#
# It fires as a side effect of viewing a page rather than of a click — like
# the artist discography walk below — so it has a switch. Set to false and
# this fetch stops firing. It is one of three unattended Spotify requests, each
# with its own cost and its own switch: ENCORE_ARTIST_ALBUMS_ENABLED below is
# the discography walk, and ENCORE_NOWPLAYING_INTERVAL above is the now-playing
# poller. Listings already cached are still shown when it is off, with the date
# they were read; only the fetching stops.
#ENCORE_ALBUM_TRACKS_ENABLED=true
# Thirty days is long on purpose: a released album's track list does not
# change, since a re-issue gets a new album id rather than editing the old one.
# Ignored when the above is false. Must be positive.
#ENCORE_ALBUM_TRACKS_TTL=720h

# ---------------------------------------------------------------------------
# Artist discographies
# ---------------------------------------------------------------------------
# The artist page says "you have heard 4 of their 11 albums", which needs
# Spotify's own listing of everything that artist has released. Same trade as
# the album setting above and a separate switch on purpose: a discography walk
# includes every single, compilation and appearance an artist has, one request
# per fifty releases, capped at forty requests for an unusually prolific artist
# — well beyond the roughly one request an album's track list costs. Reading it
# fires on a page view rather than on a click, so it is the operator's call, and
# a 429 on this request pauses Spotify access for the whole instance the same
# way one on the album request does. Discographies already cached are still
# shown when it is off, with the date they were read; only the fetching stops.
#ENCORE_ARTIST_ALBUMS_ENABLED=true
# Seven days rather than the album setting's thirty: an album's track list does
# not change after release, but a discography grows, and a record put out today
# should be counted within a week rather than within a month. Ignored when the
# above is false. Must be positive.
#ENCORE_ARTIST_ALBUMS_TTL=168h

# ---------------------------------------------------------------------------
# Historical import
# ---------------------------------------------------------------------------
# Durable storage shared by the API and the worker. A resumed import re-reads the
# original upload, so this directory must survive a restart.
#ENCORE_IMPORT_DIR=/var/lib/encore/imports
# Records per transaction. This is the main lever on peak memory, which is
# O(batch size x record size). See docs/import.md for measured figures.
#ENCORE_IMPORT_BATCH_SIZE=1000
#ENCORE_IMPORT_MAX_UPLOAD_BYTES=4gb
# Plays shorter than this are counted as skipped rather than stored. Set to
# 30000 to match Spotify's own definition of a stream, or 0 to keep everything.
#ENCORE_IMPORT_MIN_MS=1000
#ENCORE_IMPORT_MAX_REJECTS_PER_FILE=1000
#ENCORE_IMPORT_WORKERS=1
#ENCORE_IMPORT_LEASE_TTL=60s
#ENCORE_IMPORT_BATCH_RETRIES=6
# Keep uploads after a job completes so it can be re-run.
#ENCORE_IMPORT_RETAIN_FILES=true

# ---------------------------------------------------------------------------
# Metadata enrichment
# ---------------------------------------------------------------------------
#ENCORE_ENRICH_ENABLED=true
#ENCORE_ENRICH_INTERVAL=5s
#ENCORE_ENRICH_BATCH_SIZE=50
# Resolving names-only account-data listens costs one search request each, so it
# gets its own, much smaller rate budget.
#ENCORE_ENRICH_ALIAS_ENABLED=true
#ENCORE_ENRICH_ALIAS_RATE=2
#ENCORE_ENRICH_REPAIR_INTERVAL=6h
#ENCORE_ROLLUP_INTERVAL=30s

# ---------------------------------------------------------------------------
# Metadata fallback (optional)
# ---------------------------------------------------------------------------
# A second source of track, artist and album metadata, consulted while Spotify
# is rate limiting this instance and for ids Spotify will not serve at all.
#
# Off unless the URL is set. The contract is three Spotify-shaped endpoints and
# is documented in docs/metadata-fallback.md. Encore ships no fallback and
# endorses none: what you serve from your own endpoint is your affair.
#ENCORE_METADATA_FALLBACK_URL=https://metadata.internal
#ENCORE_METADATA_FALLBACK_TOKEN=
#ENCORE_METADATA_FALLBACK_TIMEOUT=10s
#ENCORE_METADATA_FALLBACK_BATCH_SIZE=50
#ENCORE_METADATA_FALLBACK_RATE_LIMIT=
#ENCORE_METADATA_FALLBACK_RATE_BURST=1
# Ask the fallback before Spotify, so the Spotify quota is spent only on what
# the fallback does not have. Set false to keep Spotify first.
#ENCORE_METADATA_FALLBACK_PREFER=true

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------
#ENCORE_METRICS_ENABLED=true
# Set both to require basic auth on /metrics. Leave both empty only on a network
# where anyone who can reach the port is already trusted.
#ENCORE_METRICS_USERNAME=
#ENCORE_METRICS_PASSWORD=

# ---------------------------------------------------------------------------
# Worker identity
# ---------------------------------------------------------------------------
# Identifies this process in import job leases. Defaults to the hostname.
#ENCORE_WORKER_ID=

# ---------------------------------------------------------------------------
# Deployment (read by docker-compose.yml, not by Encore itself)
# ---------------------------------------------------------------------------
# Host ports. Behind a reverse proxy you usually want to bind these to loopback
# with ENCORE_BIND_ADDR so nothing is reachable except through the proxy.
#ENCORE_BIND_ADDR=127.0.0.1
#ENCORE_WEB_PORT=3000
#ENCORE_API_PORT=8080

# Published images and the tag to run. Pin the tag for a reproducible deploy.
#ENCORE_IMAGE=ghcr.io/requidev/encore
#ENCORE_WEB_IMAGE=ghcr.io/requidev/encore-web
#ENCORE_VERSION=latest

# ---------------------------------------------------------------------------
# Spotify endpoints (rarely changed)
# ---------------------------------------------------------------------------
# Only for pointing Encore at a proxy in front of Spotify, or at a stub when
# testing. Leave unset to use Spotify itself.
#ENCORE_SPOTIFY_API_BASE_URL=https://api.spotify.com
#ENCORE_SPOTIFY_AUTH_BASE_URL=https://accounts.spotify.com
